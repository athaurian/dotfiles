__pycache__/
.mypy_cache/
.ruff_cache/

.config/wlsunset.env

# The test suites are for development only. The Makefile runs them from the
# source tree, so the applied config does not need them.
.local/bin/tests

# The launcher helper is compiled into ~/.local/bin during apply.
.local/share/launcher-dim

# The optiplex hostname selects the i3 set. Each other hostname selects the
# thinkpad set. The same hostname selects the package list in
# data/packages.json, which run_onchange_before_onboarding.sh reads with
# thinkpad as its fallback.
{{ if eq .chezmoi.hostname "optiplex" }}
.config/sway
.config/fuzzel
.config/swaylock
.config/waybar
.config/systemd/user/awww-daemon.service
.config/systemd/user/cliphist.service
.config/systemd/user/sway-session.target
.config/systemd/user/sway-session.target.wants
.config/systemd/user/swayidle-unlocked.service
.config/systemd/user/swayidle-locked.service
.config/systemd/user/calibre-sync.service
.config/systemd/user/calibre-sync.timer
.config/systemd/user/calibre-sync-netmon.service
.config/systemd/user/wlsunset.service
.config/systemd/user/wlsunset-env.service
{{ else }}
.config/i3
.config/rofi
.config/polybar
.config/picom.conf
.config/flameshot
.config/systemd/user/i3-session.target
.config/systemd/user/i3-session.target.wants
.config/systemd/user/redshift.service
{{ end }}
