#!/usr/bin/env sh
set -eu

dir="{{ .chezmoi.sourceDir }}/.local/share/launcher-dim"
bin="$HOME/.local/bin/launcher_dim"

need() {
	for tool in "$@"; do
		if ! command -v "$tool" >/dev/null 2>&1; then
			printf 'launcher_dim: missing %s\n' "$tool" >&2
			exit 1
		fi
	done
}

build_wayland() {
	need wayland-scanner cc pkg-config
	build="${XDG_CACHE_HOME:-$HOME/.cache}/launcher-dim"
	xml="$dir/wlr-layer-shell-unstable-v1.xml"
	protocols=$(pkg-config --variable=pkgdatadir wayland-protocols)
	mkdir -p "$build"
	wayland-scanner client-header "$xml" \
		"$build/wlr-layer-shell-unstable-v1-client-protocol.h"
	wayland-scanner private-code "$xml" \
		"$build/wlr-layer-shell-unstable-v1-protocol.c"
	# The layer shell names xdg_popup in its get_popup request, so the
	# xdg-shell interfaces are needed to link.
	wayland-scanner client-header "$protocols/stable/xdg-shell/xdg-shell.xml" \
		"$build/xdg-shell-client-protocol.h"
	wayland-scanner private-code "$protocols/stable/xdg-shell/xdg-shell.xml" \
		"$build/xdg-shell-protocol.c"
	# shellcheck disable=SC2046
	cc -O2 -Wall -Wextra -Werror -I "$build" -o "$bin.new" \
		"$dir/launcher_dim_wayland.c" \
		"$build/wlr-layer-shell-unstable-v1-protocol.c" \
		"$build/xdg-shell-protocol.c" \
		$(pkg-config --cflags --libs wayland-client)
}

build_x11() {
	need cc pkg-config
	# shellcheck disable=SC2046
	cc -O2 -Wall -Wextra -Werror -o "$bin.new" "$dir/launcher_dim_x11.c" \
		$(pkg-config --cflags --libs x11 xext)
}

{{ if eq .chezmoi.hostname "optiplex" }}
sources="$dir/launcher_dim_x11.c"
build=build_x11
{{ else }}
sources="$dir/launcher_dim_wayland.c $dir/wlr-layer-shell-unstable-v1.xml"
build=build_wayland
{{ end }}

stale=0
[ -x "$bin" ] || stale=1
for source in $sources; do
	if [ ! -f "$bin" ] || [ ! "$bin" -nt "$source" ]; then
		stale=1
	fi
done
if [ "$stale" -eq 0 ]; then
	exit 0
fi

mkdir -p "$(dirname "$bin")"
"$build"
mv "$bin.new" "$bin"
