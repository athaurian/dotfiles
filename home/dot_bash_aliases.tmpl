# CLI aliases
alias cat='bat --theme=ansi'
alias ff='fastfetch'
alias g='git'
alias grep='grep --color=auto'
alias lg='lazygit'
alias ls='ls --color=auto --human-readable'
alias v='${EDITOR:-nvim}'
alias ze='zellij'

# Listing variants
alias ll='ls -lAhF'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -lhtr'
alias lS='ls -lhSr'
alias ldir='ls -d */'

# Utilities & navigation
alias c='clear'
alias h='history'
alias hdel='rm -vi $HOME/.bash_history && exec $SHELL'
alias myip='curl -s ifconfig.me'
alias sha='shasum -a 256'
