# Mode comes from meta/palette.toml. The applied copy is generated from this template.
# {{- $mode := .mode }}
[Settings]
gtk-theme-name={{ index .themes.gtk $mode }}
gtk-icon-theme-name={{ index .themes.icons $mode }}
gtk-font-name={{ .fonts.sans }} 10
gtk-cursor-theme-name={{ .themes.cursor }}
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme={{ if eq $mode "light" }}false{{ else }}true{{ end }}
