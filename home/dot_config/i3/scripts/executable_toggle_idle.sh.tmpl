#!/usr/bin/env sh
set -eu

# shellcheck source=lib_runtime.sh
. "$HOME/.local/lib/lib_runtime.sh"
# chezmoi renders this template. The idle timings come from .chezmoidata.toml.

id_file="$(runtime_dir)/caffeine_toggle_id"
lock_file="$(runtime_dir)/caffeine_toggle.lock"
app_name="caffeine-toggle"

exec 9>"$lock_file"
flock -w 2 9 || exit 0

screensaver_timeout() {
	xset q 2>/dev/null | sed -n 's/.*timeout: *\([0-9]\+\).*/\1/p' | head -n 1
}

disable_timers() {
	if ! xset s off; then
		send_notice "$app_name" "$id_file" " Caffeine toggle failed" "<b>Xset s off failed.</b>"
		exit 1
	fi
	if ! xset -dpms; then
		send_notice "$app_name" "$id_file" " Caffeine toggle failed" "<b>Xset -dpms failed.</b>"
		exit 1
	fi
	send_notice "$app_name" "$id_file" "󰒳 Caffeine mode on" "<b>idle timers disabled.</b> The system stays awake indefinitely."
}

enable_timers() {
	if ! xset s {{ .idle.screensaver }}; then
		send_notice "$app_name" "$id_file" " Caffeine toggle failed" "<b>Xset s 20 10 failed.</b>"
		exit 1
	fi
	if ! xset +dpms || ! xset dpms {{ .idle.dpms }}; then
		send_notice "$app_name" "$id_file" " Caffeine toggle failed" "<b>Xset dpms failed.</b>"
		exit 1
	fi
	send_notice "$app_name" "$id_file" "󰒲 Caffeine mode off" "<b>idle timers restored.</b> Normal idle rules apply."
}

timeout_value=$(screensaver_timeout)

case "$timeout_value" in
0) enable_timers ;;
"")
	send_notice "$app_name" "$id_file" " Caffeine toggle failed" "<b>Could not read the screensaver timeout.</b>"
	exit 1
	;;
*) disable_timers ;;
esac
