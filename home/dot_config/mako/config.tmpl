#{{ $c := .flint.resolved }}
#{{ $d := .flint.desktop }}

anchor=top-right
margin=8
padding=10,14
width=340
height=110
border-size=1
border-radius=0
default-timeout=5000
max-visible=4
max-history=50
layer=overlay
sort=-time

font={{ $d.font_family_nerd }} Propo {{ $d.font_size }}
markup=1
format=<b>%s</b>\n%b
icons=1
max-icon-size=32

# The card surface is the base background in every urgency, swaylock-style.
# Urgency is carried by text, border, and progress color, never the fill.
background-color={{ $c.background.hex }}
text-color={{ $c.text.hex }}
border-color={{ $c.overlay_strong.hex }}
progress-color=over {{ $c.notice_accent.hex }}

[urgency=low]
background-color={{ $c.background.hex }}
text-color={{ $c.text_secondary.hex }}
border-color={{ $c.border_inactive.hex }}
progress-color=over {{ $c.text_muted.hex }}
default-timeout=3000

[urgency=normal]
background-color={{ $c.background.hex }}
text-color={{ $c.text.hex }}
border-color={{ $c.overlay_strong.hex }}
progress-color=over {{ $c.notice_accent.hex }}

[urgency=critical]
background-color={{ $c.background.hex }}
text-color={{ $c.error.hex }}
border-color={{ $c.error.hex }}
progress-color=over {{ $c.error.hex }}
default-timeout=0

[category=mpd]
default-timeout=2000

[mode=locked]
invisible=1
default-timeout=0

[mode=do-not-disturb]
invisible=1

# Keep toggle confirmations visible even while DND is active.
# [mode=do-not-disturb] hides everything, but the user still needs to see
# that a toggle they just pressed actually ran. Without an exception the
# "DND enabled" bubble (and the other toggles) would be hidden/dismissed
# the moment the mode is entered, so the replacement ID would point at a
# dismissed notification and the next toggle would flash a new bubble
# instead of replacing the old one.
[app-name="mako-dnd" mode=do-not-disturb]
invisible=0

[app-name="caffeine-toggle" mode=do-not-disturb]
invisible=0

[app-name="wallpaper-rotate" mode=do-not-disturb]
invisible=0

# vim: ft=dosini
