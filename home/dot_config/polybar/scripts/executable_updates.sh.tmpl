#!/usr/bin/env sh
set -eu
# chezmoi renders this template. Colors come from meta/palette.toml.
# {{- $p := .palette }}
poked=0
trap 'poked=1' USR1
err_file=$(mktemp) || exit 1
trap 'rm -f "$err_file"' EXIT

# checkupdates exits 2 and paru -Qum exits 1 when there are no updates. The
# exit code is not a failure. Only output on stderr shows a failure.
check_backend() {
	backend_out=$("$@" 2>"$err_file") || true
	if [ -s "$err_file" ]; then
		failed=1
	fi
	: >"$err_file"
	backend_count=$(printf '%s\n' "$backend_out" | grep -c . 2>/dev/null || true)
	count=$((count + ${backend_count:-0}))
}

report() {
	count=0
	failed=0
	has_checkupdates=0
	has_paru=0

	if command -v checkupdates >/dev/null 2>&1; then
		has_checkupdates=1
		check_backend checkupdates
	fi

	if command -v paru >/dev/null 2>&1; then
		has_paru=1
		check_backend paru -Qum
	fi

	if [ "$has_checkupdates" -eq 0 ] && [ "$has_paru" -eq 0 ]; then
		printf '%%{F{{ $p.muted.hex }}}%%{F-}\n'
		return 0
	fi

	if [ "$count" -gt 0 ]; then
		printf '%%{F{{ $p.yellow.hex }}}󰚰 %s%%{F-}\n' "$count"
	elif [ "$failed" -eq 1 ]; then
		printf '%%{F{{ $p.red.hex }}}󰚰 !%%{F-}\n'
	else
		printf '%%{F{{ $p.muted.hex }}}󰏓 0%%{F-}\n'
	fi
}

while :; do
	poked=0
	report
	sleep 3600 &
	sleeper=$!
	if [ "$poked" -eq 0 ]; then
		wait "$sleeper" || true
	fi
	kill "$sleeper" 2>/dev/null || true
done
