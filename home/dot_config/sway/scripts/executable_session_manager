#!/usr/bin/env python3
"""Sway session manager entry point."""

import sys
from pathlib import Path

# Write bytecode caches under ~/.cache instead of next to the scripts,
# so the chezmoi-managed tree stays clean.
sys.pycache_prefix = str(Path.home() / ".cache" / "dotfiles" / "pycache")

sys.path.insert(0, str(Path(__file__).resolve().parent))

from session_manager_lib.__main__ import main

main()
