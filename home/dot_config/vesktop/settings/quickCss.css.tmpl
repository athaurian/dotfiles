/* Fonts come from .chezmoidata.toml. The applied copy is generated from this template. */
@import url("https://fonts.googleapis.com/css2?family={{ urlquery .fonts.code }}:ital,wght@0,200..900;1,200..900&family={{ urlquery .fonts.sans }}:ital,wght@0,200..900;1,200..900&display=swap");

:root {
  --font-primary: "{{ .fonts.sans }}", sans-serif !important;
  --font-display: "{{ .fonts.sans }}", sans-serif !important;
  --font-headline: "{{ .fonts.sans }}", sans-serif !important;
  --font-mono: "{{ .fonts.code }}", monospace !important;
}
