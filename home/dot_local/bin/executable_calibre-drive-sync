#!/usr/bin/env python3
"""Mirror the Calibre library to Google Drive as a flat folder.

Stages every EPUB/PDF via hardlinks and lets rclone mirror them to
gdrive:Books. Flat names are rebuilt as "Author - Series NN - Title.ext"
from calibredb metadata (cached against metadata.db's mtime), with a
hash suffix appended on collisions.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from collections import Counter
from pathlib import Path

LIBRARY_DIR = Path("~/Library").expanduser()
CACHE_ROOT = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
STAGING_DIR = CACHE_ROOT / "calibre-drive-sync" / "flat"
METADATA_CACHE = CACHE_ROOT / "calibre-drive-sync" / "library.json"
REMOTE = "gdrive:Books"
BOOK_EXTENSIONS = {".epub", ".pdf"}
METADATA_FIELDS = "title,authors,series,series_index,formats"
HASH_LENGTH = 8


def warn(message: str) -> None:
    print(f"warning: {message}", file=sys.stderr)


def die(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def find_books(library: Path) -> list[Path]:
    """Return every EPUB/PDF under the library, sorted for stable output."""
    books = [
        path
        for path in library.rglob("*")
        if path.is_file() and path.suffix.lower() in BOOK_EXTENSIONS
    ]
    return sorted(books)


def db_fingerprint(library: Path) -> dict:
    """Identity of the Calibre database, used to invalidate the cache."""
    try:
        stat = (library / "metadata.db").stat()
    except OSError:
        die(f"Calibre database not found at {library / 'metadata.db'}")
    return {"mtime_ns": stat.st_mtime_ns, "size": stat.st_size}


def query_metadata(library: Path) -> dict[str, dict]:
    """Map every format file path to its Calibre metadata entry."""
    result = subprocess.run(
        [
            "calibredb",
            "list",
            "--for-machine",
            "--library-path",
            str(library),
            "--fields",
            METADATA_FIELDS,
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or f"calibredb exited with {result.returncode}"
        )
    entries = json.loads(result.stdout)
    return {
        format_path: entry
        for entry in entries
        for format_path in entry.get("formats") or []
    }


def load_metadata(library: Path) -> dict[str, dict] | None:
    """Cached format-path -> metadata map, refreshed when metadata.db changes."""
    fingerprint = db_fingerprint(library)
    if METADATA_CACHE.exists():
        try:
            cache = json.loads(METADATA_CACHE.read_text())
            if cache["fingerprint"] == fingerprint:
                return cache["entries"]
        except (OSError, ValueError, KeyError):
            warn("metadata cache is corrupt; querying calibredb again")

    try:
        entries = query_metadata(library)
    except (OSError, RuntimeError, json.JSONDecodeError) as error:
        warn(f"could not read Calibre metadata ({error}); using raw filenames")
        return None

    METADATA_CACHE.parent.mkdir(parents=True, exist_ok=True)
    temporary = METADATA_CACHE.with_suffix(".json.tmp")
    temporary.write_text(json.dumps({"fingerprint": fingerprint, "entries": entries}))
    temporary.replace(METADATA_CACHE)
    return entries


def sanitize(name: str) -> str:
    return name.replace(os.sep, "_").strip()


def format_index(index: float) -> str:
    """Zero-padded series position: 1.0 -> '01', 8.5 -> '08.5'."""
    text = f"{index:g}"
    whole, _, fraction = text.partition(".")
    padded = f"{int(whole):02d}"
    return f"{padded}.{fraction}" if fraction else padded


def clean_title(title: str, series: str) -> str:
    """Drop a leading "<Series>, Book NN:" echo from the title."""
    pattern = re.compile(
        rf"^{re.escape(series)}\s*,\s*Book\s+\d+(?:\.\d+)?\s*[:_]\s*",
        re.IGNORECASE,
    )
    stripped = pattern.sub("", title)
    return stripped or title


def display_name(entry: dict) -> str:
    """Readable flat name: Author - Series NN - Title."""
    parts = [entry.get("authors") or "Unknown"]
    series = entry.get("series")
    title = entry.get("title") or "Untitled"
    if series:
        parts.append(f"{series} {format_index(entry.get('series_index', 0))}")
        # The series position is already in the name; drop the title's own
        # "<Series>, Book NN:" prefix when Calibre baked it in.
        title = clean_title(title, series)
    parts.append(title)
    return sanitize(" - ".join(parts))


def plan_names(books: list[Path], metadata: dict[str, dict] | None) -> list[str]:
    """Final flat filename for each book, hash-suffixed on collisions."""
    bases = []
    for book in books:
        entry = metadata.get(str(book)) if metadata else None
        stem = display_name(entry) if entry else book.stem
        bases.append(f"{stem}{book.suffix}")

    counts = Counter(bases)
    planned = []
    for book, base in zip(books, bases):
        if counts[base] > 1:
            digest = hashlib.sha256(str(book).encode()).hexdigest()
            stem, suffix = os.path.splitext(base)
            base = f"{stem} [{digest[:HASH_LENGTH]}]{suffix}"
        planned.append(base)
    return planned


def restage(books: list[Path], metadata: dict[str, dict] | None) -> None:
    """Rebuild the staging directory so it mirrors the library exactly."""
    if STAGING_DIR.exists():
        shutil.rmtree(STAGING_DIR)
    STAGING_DIR.mkdir(parents=True)

    linked = 0
    for book, name in zip(books, plan_names(books, metadata)):
        target = STAGING_DIR / name
        try:
            os.link(book, target)
        except OSError:
            # Different filesystem than the cache directory; copy instead.
            shutil.copy2(book, target)
        linked += 1
    print(f"staged {linked} books in {STAGING_DIR}")


def sync(dry_run: bool) -> None:
    """Mirror the staging directory to the remote with rclone."""
    command = ["rclone", "sync", str(STAGING_DIR), REMOTE, "--update"]
    if dry_run:
        command.append("--dry-run")
    result = subprocess.run(command, check=False)
    if result.returncode != 0:
        die(f"rclone exited with status {result.returncode}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="stage locally but pass --dry-run to rclone",
    )
    args = parser.parse_args()

    if shutil.which("rclone") is None:
        die("rclone is not installed")
    if not LIBRARY_DIR.is_dir():
        die(f"Calibre library not found at {LIBRARY_DIR}")

    books = find_books(LIBRARY_DIR)
    if not books:
        # An empty staging directory would make rclone sync wipe the remote.
        die(f"no EPUB/PDF files found in {LIBRARY_DIR}; refusing to sync")

    restage(books, load_metadata(LIBRARY_DIR))
    sync(args.dry_run)
    print(f"synced to {REMOTE}")


if __name__ == "__main__":
    main()
