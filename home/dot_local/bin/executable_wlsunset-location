#!/usr/bin/env python3
"""Generate wlsunset.env from the machine's location."""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import UTC, datetime
from pathlib import Path
from typing import NoReturn

USER_AGENT = "wlsunset-location/1.0"

MARKERS = (".git", ".chezmoi", ".chezmoiroot", ".chezmoidata", ".chezmoidata.yaml")

PROVIDERS = {
    "ipinfo": ("https://ipinfo.io/json", "loc"),
    "geojs": ("https://get.geojs.io/v1/ip/geo.json", "kv"),
    "ipapi": ("https://ipapi.co/json/", "kv"),
}

DEFAULT_PROVIDERS = "ipinfo geojs ipapi"

COORD_RE = re.compile(r"^[+-]?[0-9]+(?:\.[0-9]+)?$")
GEOCLUE_RE = re.compile(
    r"^\s*[Ll](?:atitude|ongitude):\s*(-?[0-9.]{1,12})", re.MULTILINE
)

HELP_EPILOG = """\
Sources, in order: --lat/--lon, geoclue (where-am-i), then IP
geolocation ($WLSUNSET_GEO_PROVIDERS, default "ipinfo geojs ipapi";
HTTPS only). Behind a VPN, IP geolocation is wrong by design; pass
--lat/--lon once or let geoclue handle it.

The generated file is machine-local state. Add .config/wlsunset.env to
.chezmoiignore so it is never deployed or committed.

Exit codes:
  0  success          2  no location source succeeded
  1  usage error      3  output path refused by the source-tree guard\
"""


class _Parser(argparse.ArgumentParser):
    def error(self, message: str) -> NoReturn:
        self.exit(1, f"error: {message}\n")


def _parser() -> _Parser:
    parser = _Parser(
        prog="wlsunset-location",
        description=(
            "wlsunset-location: generate wlsunset.env from the machine's location"
        ),
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
        allow_abbrev=False,
    )
    parser.add_argument(
        "-o",
        "--output",
        default=default_target(),
        metavar="PATH",
        help="target file (default: ~/.config/wlsunset.env)",
    )
    parser.add_argument(
        "-l",
        "--lat",
        metavar="DEG",
        help="latitude to use instead of a lookup (with --lon)",
    )
    parser.add_argument(
        "--lon",
        metavar="DEG",
        help="longitude to use instead of a lookup (with --lat)",
    )
    parser.add_argument(
        "-p",
        "--precision",
        type=int,
        default=2,
        metavar="N",
        help="decimal digits kept, 0-6 (default 2, about 1 km)",
    )
    parser.add_argument(
        "-t",
        "--timeout",
        type=int,
        default=10,
        metavar="SEC",
        help="seconds before each source gives up (default 10)",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="allow writing inside a git or chezmoi source tree",
    )
    parser.add_argument("-h", "--help", action="help", help="show this help")
    return parser


def warn(message: str) -> None:
    print(f"warning: {message}", file=sys.stderr)


def error(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)


def log(message: str) -> None:
    print(message, file=sys.stderr)


def die(message: str, code: int = 1) -> NoReturn:
    error(message)
    raise SystemExit(code)


def default_target() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return str(Path(base) / "wlsunset.env")


def valid_coord_pair(lat: str, lon: str) -> bool:
    if not COORD_RE.fullmatch(lat) or not COORD_RE.fullmatch(lon):
        return False
    return -90 <= float(lat) <= 90 and -180 <= float(lon) <= 180


def round_coord(value: str, precision: int) -> str:
    return f"{float(value):.{precision}f}"


def fetch(url: str, timeout: int) -> str | None:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.read().decode("utf-8", "replace")
    except (urllib.error.URLError, OSError, ValueError):
        return None


def provider_coordinates(body: str, style: str) -> tuple[str, str] | None:
    try:
        data = json.loads(body)
    except json.JSONDecodeError:
        return None
    if not isinstance(data, dict):
        return None

    if style == "loc":
        pair = data.get("loc")
        if not isinstance(pair, str) or "," not in pair:
            return None
        parts = [part.strip() for part in pair.split(",")]
        lat, lon = parts[0], parts[-1]
    else:
        lat_value = data.get("latitude")
        lon_value = data.get("longitude")
        if lat_value is None or lon_value is None:
            return None
        lat, lon = str(lat_value), str(lon_value)

    if not valid_coord_pair(lat, lon):
        return None
    return lat, lon


def _coordinate_from_text(text: str, word: str) -> str:
    match = re.search(rf"^\s*[Ll]{word}:\s*(-?[0-9.]{{1,12}})", text, re.MULTILINE)
    return match.group(1) if match else ""


def source_geoclue(timeout: int) -> tuple[str, str, str] | None:
    if shutil.which("where-am-i") is None or shutil.which("timeout") is None:
        return None

    log(f"looking up location via geoclue (where-am-i, {timeout}s limit) ...")
    try:
        proc = subprocess.run(
            ["timeout", str(timeout), "where-am-i"],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None

    lat = _coordinate_from_text(proc.stdout, "atitude")
    lon = _coordinate_from_text(proc.stdout, "ongitude")
    if not valid_coord_pair(lat, lon):
        return None
    return lat, lon, "geoclue"


def source_ip_geo(providers: str, timeout: int) -> tuple[str, str, str] | None:
    if not providers:
        return None

    for slug in providers.split():
        if slug not in PROVIDERS:
            warn(f"unknown provider '{slug}' in WLSUNSET_GEO_PROVIDERS; skipping")
            continue

        url, style = PROVIDERS[slug]
        log(f"looking up location via {slug} ...")
        body = fetch(url, timeout)
        if body is None:
            warn(f"{slug}: request failed")
            continue

        pair = provider_coordinates(body, style)
        if pair is None or not valid_coord_pair(*pair):
            warn(f"{slug}: response did not contain a usable coordinate pair")
            continue
        return pair[0], pair[1], slug

    return None


def guard_target(target: str, force: bool) -> None:
    path = Path(os.path.abspath(target))
    directory = path.parent
    while True:
        for marker in MARKERS:
            if (directory / marker).exists():
                warn(f"{target} is inside {directory} (found {marker})")
                if force:
                    warn("--force given, writing anyway")
                    return
                die("choose a target outside the source tree, or pass --force", 3)
        if directory == directory.parent:
            return
        directory = directory.parent


def write_env(target: str, lat: str, lon: str, source: str) -> None:
    path = Path(target)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError:
        die(f"cannot create directory: {path.parent}")

    temp: Path | None = None
    stamp = datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        with tempfile.NamedTemporaryFile(
            "w", dir=path.parent, prefix=".wlsunset.env.", delete=False
        ) as handle:
            temp = Path(handle.name)
            handle.write(
                f"# Generated by wlsunset-location ({source} source) on {stamp}.\n"
            )
            handle.write(
                "# Machine-local; do not commit. Regenerate with: wlsunset-location\n"
            )
            handle.write(f'WLSUNSET_LATITUDE="{lat}"\n')
            handle.write(f'WLSUNSET_LONGITUDE="{lon}"\n')
        os.replace(temp, path)
    except OSError:
        if temp is not None:
            temp.unlink(missing_ok=True)
        die(f"cannot write {path}")


def restart_service() -> None:
    if shutil.which("systemctl") is None:
        return
    state = subprocess.run(
        [
            "systemctl",
            "--user",
            "show",
            "-p",
            "ActiveState",
            "--value",
            "wlsunset.service",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    # A pending start is ordered after this unit. Restarting it here would make
    # both jobs wait for each other.
    if state.stdout.strip() != "active":
        return
    queued = subprocess.run(
        ["systemctl", "--user", "restart", "--no-block", "wlsunset.service"],
        capture_output=True,
        check=False,
    )
    if queued.returncode == 0:
        log("restarted wlsunset.service")
    else:
        warn("could not restart wlsunset.service")


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)

    if not 0 <= args.precision <= 6:
        die("precision must be between 0 and 6")
    if args.timeout < 1:
        die("timeout must be at least 1 second")

    has_lat = bool(args.lat)
    has_lon = bool(args.lon)
    if has_lat != has_lon:
        die("--lat and --lon must be given together")

    if has_lat:
        if not valid_coord_pair(args.lat, args.lon):
            die(
                "invalid coordinates (need decimal degrees: lat in ±90, "
                f"lon in ±180), got lat={args.lat} lon={args.lon}"
            )
        lat, lon, source = args.lat, args.lon, "manual"
    else:
        found = source_geoclue(args.timeout)
        if found is None:
            providers = os.environ.get("WLSUNSET_GEO_PROVIDERS", DEFAULT_PROVIDERS)
            found = source_ip_geo(providers, args.timeout)
        if found is None:
            die(
                "could not determine the location from any source "
                "(the existing file was left untouched)",
                2,
            )
        lat, lon, source = found

    lat = round_coord(lat, args.precision)
    lon = round_coord(lon, args.precision)
    if not valid_coord_pair(lat, lon):
        die(f"rounded coordinates failed validation (this is a bug): {lat} {lon}")

    guard_target(args.output, args.force)
    write_env(args.output, lat, lon, source)

    log(f"wrote {args.output} (source: {source})")
    log(f'  WLSUNSET_LATITUDE="{lat}"')
    log(f'  WLSUNSET_LONGITUDE="{lon}"')
    restart_service()
    return 0


if __name__ == "__main__":
    sys.exit(main())
